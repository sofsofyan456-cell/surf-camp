generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Config {
  id             Int    @id @default(autoincrement())
  name           String
  whatsappNumber String
  address        String @default("123 Coastal Road, Taghazout, Morocco")
  contactEmail   String @default("youssefalhyan@gmail.com")
  heroImage      String @default("https://images.unsplash.com/photo-1502680390469-be75c86b636f?auto=format&fit=crop&q=80&w=2000")
  heroText       String @default("Comfort Stay, Better Waves")
  aboutTitle     String @default("Our Story")
  aboutText1     String @default("Welcome to Surf & Sand! We created this space to share our passion for the ocean, local culture, and meeting people from all over the world.")
  aboutText2     String @default("Whether you are catching your first wave, looking for a comfortable bed after a long day of exploring, or wanting to share stories around the evening fire, you will find your home here.")
  aboutImage     String @default("/about-us.png")
}

model Room {
  id            String @id
  name          String
  description   String
  capacity      Int
  beds          String
  pricePerNight Int
  image         String
}

model Activity {
  id          String @id
  title       String
  description String
  image       String
}

model AdminAccount {
  id                   String         @id @default(cuid())
  username             String         @unique
  passwordHash         String
  recoveryEmail        String         @unique
  pendingRecoveryEmail String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sessions             AdminSession[]
  tokens               AdminToken[]
}

model AdminSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model AdminToken {
  id           String       @id @default(cuid())
  tokenHash    String       @unique
  purpose      String
  pendingEmail String?
  adminId      String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  admin        AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, purpose])
  @@index([expiresAt])
}
